{
  "name": "vid-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,web,media,gate -c blue,green,magenta,yellow \"bun run convex\" \"bun run web\" \"bun run media\" \"bun run gate\"",
    "convex": "convex dev --tail-logs disable",
    "web": "vite",
    "media": "bun media/server.ts",
    "gate": "bun gate/gate.ts",
    "typecheck": "tsc -p . --noEmit && tsc -p convex --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "convex": "^1.46.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
